# ==============================================================
# MAN AK BAE ❤️ - Variables d'environnement (Exemple de configuration)
# ==============================================================

# --- DJANGO BACKEND ---
DEBUG=True
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-at-least-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*.ngrok-free.app,*.railway.app,*.render.com
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,exp://localhost:8081

# Fuseau horaire officiel du projet
TIME_ZONE=Africa/Dakar

# --- POSTGRESQL DATABASE ---
DB_NAME=manakbae_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manakbae_db

# --- REDIS / DJANGO CHANNELS (WebSockets) ---
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CHANNEL_LAYER=False

# --- SIMPLE JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- STOCKAGE MÉDIAS (Compatible AWS S3 / Cloudflare R2 / Supabase Storage / Scaleway) ---
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_STORAGE_BUCKET_NAME=manakbae-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# --- NOTIFICATIONS PUSH EXPO ---
EXPO_ACCESS_TOKEN=your-expo-access-token-optional

# --- MOBILE (EXPO) ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:8000/ws

