{
  "expo": {
    "name": "Man Ak Bae ❤️",
    "slug": "man-ak-bae",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#17151C"
    },
    "scheme": "manakbae",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.manakbae.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Man Ak Bae a besoin d'accéder à l'appareil photo pour partager vos moments et selfies avec votre moitié.",
        "NSPhotoLibraryUsageDescription": "Man Ak Bae a besoin d'accéder à votre galerie pour enregistrer vos précieux souvenirs de couple.",
        "NSMicrophoneUsageDescription": "Man Ak Bae a besoin du micro pour envoyer des messages vocaux doux à votre partenaire."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17151C"
      },
      "package": "com.manakbae.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-image-picker",
      "expo-av"
    ]
  }
}

